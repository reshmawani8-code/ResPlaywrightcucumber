{
  "compilerOptions": {
"target": "ES2020",
    "module": "commonjs",
"lib": ["ES2020"],
"strict": true,
"esModuleInterop": true,
"skipLibCheck": true,
"forceConsistentCasingInFileNames": true,
"resolveJsonModule": true,
"declaration": true,
"declarationMap": true,
"sourceMap": true,
"outDir": "./dist",
"rootDir": ".",
"types": ["node"]
},
"include": [
"pages/**/*.ts",
"step-definations/**/*.ts",
"features/**/*.feature"
],
"exclude": ["node_modules"]
}